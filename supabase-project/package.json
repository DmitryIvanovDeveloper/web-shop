{
  "name": "webshops-supabase",
  "version": "1.0.0",
  "description": "Supabase backend for webshops-specs project",
  "main": "index.js",
  "scripts": {
    "dev": "supabase start",
    "start": "supabase start",
    "stop": "supabase stop",
    "reset": "supabase db reset",
    "migrate": "supabase db push",
    "migrate:remote": "supabase db push --include-all",
    "generate": "supabase gen types typescript --local > types/supabase.ts",
    "generate:remote": "supabase gen types typescript --project-id qosblydpgejtnyvzctpg > types/supabase.ts",
    "studio": "supabase studio",
    "link": "supabase link --project-ref qosblydpgejtnyvzctpg",
    "setup": "node setup-remote.js",
    "integrate": "node setup-integration.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "supabase",
    "webshops",
    "backend",
    "database"
  ],
  "author": "Development AI Team",
  "license": "MIT",
  "devDependencies": {
    "supabase": "^2.53.6",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.76.1"
  }
}
