          "fontWeight": "bold",
          "marginBottom": 8,
          "textAlign": "center"
        }
      },
      {
        "type": "OffersList",
        "id": "evaluated-offers",
        "props": {},
        "styles": {
          "className": "mb-6"
        }
      },
      {
        "type": "ProductsList",
        "id": "products-list",
        "props": {},
        "styles": {
          "className": ""
        }
      }
    ]
  }
