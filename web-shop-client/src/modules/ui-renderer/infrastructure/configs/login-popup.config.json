{
  "version": "1.0",
  "theme": {
    "colors": {
      "primary": "#FBBF24",
      "background": "#1F2937",
      "surface": "#374151",
      "text": "#FFFFFF",
      "textSecondary": "#9CA3AF",
      "success": "#10B981",
      "error": "#EF4444"
    },
    "spacing": [0, 4, 8, 12, 16, 20, 24, 32, 40, 48, 64, 80]
  },
  "layout": {
    "id": "login-popup",
    "type": "Popup",
    "props": {
      "isOpen": true,
      "showCloseButton": true
    },
        "styles": {
          "backgroundColor": "#1F2937",
          "padding": 3,
          "borderRadius": 8,
          "width": "500px",
          "maxWidth": "90vw",
          "maxHeight": "90vh",
          "margin": "auto"
        },
    "children": [
      {
        "id": "logo-section",
        "type": "Container",
        "props": {
          "vertical": true
        },
        "styles": {
          "textAlign": "center",
          "marginBottom": 3
        },
        "children": [
          {
            "id": "logo-box",
            "type": "Container",
            "props": {
              "vertical": true
            },
            "styles": {
              "backgroundColor": "#000000",
              "padding": 1.5,
              "borderRadius": 4,
              "marginBottom": 1.5,
              "display": "inline-flex"
            },
            "children": [
              {
                "id": "logo-title",
                "type": "Text",
                "props": {
                  "text": "Game"
                },
                "styles": {
                  "textColor": "#FBBF24",
                  "fontWeight": "bold",
                  "fontSize": "3xl",
                  "marginBottom": 0.5,
                  "fontFamily": "monospace"
                }
              },
              {
                "id": "logo-subtitle",
                "type": "Text",
                "props": {
                  "text": "3D"
                },
                "styles": {
                  "textColor": "#FBBF24",
                  "fontSize": "3xl",
                  "fontWeight": "bold",
                  "fontFamily": "monospace"
                }
              }
            ]
          },
          {
            "id": "welcome-text",
            "type": "Text",
            "props": {
              "text": "Welcome to"
            },
            "styles": {
              "textColor": "text",
              "fontSize": "sm",
              "marginBottom": 0.5
            }
          },
          {
            "id": "title-text",
            "type": "Text",
            "props": {
              "text": "Super Game: Online Shooter Hub"
            },
            "styles": {
              "textColor": "text",
              "fontSize": "base",
              "fontWeight": "bold"
            }
          }
        ]
      },
      {
        "id": "instruction-text",
        "type": "Text",
        "props": {
          "text": "Enter your User ID to continue"
        },
        "styles": {
          "textColor": "text",
          "textAlign": "center",
          "fontSize": "sm",
          "marginBottom": 2
        }
      },
      {
        "id": "user-id-input",
        "type": "Container",
        "props": {},
        "styles": {
          "marginBottom": 2,
          "display": "flex",
          "flexDirection": "column"
        },
        "children": [
          {
            "id": "input-field",
            "type": "Container",
            "props": {},
            "styles": {
              "backgroundColor": "#374151",
              "border": "1px solid #FBBF24",
              "borderRadius": 0,
              "padding": 2,
              "width": "100%",
              "textAlign": "center",
              "flex": 1,
              "height": "52px"
            },
            "children": [
                     {
                       "id": "input-text",
                       "type": "Input",
                       "props": {
                         "placeholder": "User ID",
                         "type": "text"
                       },
                       "styles": {
                         "color": "#9CA3AF",
                         "fontSize": "14px",
                         "backgroundColor": "transparent",
                         "border": "none",
                         "outline": "none",
                         "width": "100%",
                         "textAlign": "center"
                       }
                     }
            ]
          }
        ]
      },
      {
        "id": "agreement-section",
        "type": "Container",
        "props": {
          "vertical": true
        },
        "styles": {
          "marginBottom": 3,
          "alignItems": "flex-start"
        },
        "children": [
          {
            "id": "checkbox",
            "type": "Container",
            "props": {},
            "styles": {
              "width": "16px",
              "height": "16px",
              "backgroundColor": "#374151",
              "border": "1px solid #6B7280",
              "borderRadius": 2,
              "marginRight": 1,
              "marginTop": 0.5
            }
          },
          {
            "id": "agreement-text",
            "type": "Container",
            "props": {
              "vertical": true
            },
            "styles": {
              "flex": 1
            },
            "children": [
              {
                "id": "age-text",
                "type": "Text",
                "props": {
                  "text": "I am 13 years of age or older and agree to the"
                },
                "styles": {
                  "textColor": "text",
                  "fontSize": "xs"
                }
              },
              {
                "id": "policies-links",
                "type": "Container",
                "props": {
                  "vertical": true
                },
                "styles": {
                  "marginTop": 0.5
                },
                "children": [
                  {
                    "id": "privacy-link",
                    "type": "Text",
                    "props": {
                      "text": "Privacy Policy"
                    },
                    "styles": {
                      "textColor": "#60A5FA",
                      "fontSize": "xs",
                      "marginBottom": 0.5
                    }
                  },
                  {
                    "id": "terms-link",
                    "type": "Text",
                    "props": {
                      "text": "Terms of Service"
                    },
                    "styles": {
                      "textColor": "#60A5FA",
                      "fontSize": "xs",
                      "marginBottom": 0.5
                    }
                  },
                  {
                    "id": "refund-link",
                    "type": "Text",
                    "props": {
                      "text": "Refund Policy"
                    },
                    "styles": {
                      "textColor": "#60A5FA",
                      "fontSize": "xs"
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "login-button",
        "type": "Button",
        "props": {
          "text": "Login",
          "fullWidth": true
        },
        "styles": {
          "backgroundColor": "#FBBF24",
          "textColor": "#000000",
          "padding": 2,
          "borderRadius": 8,
          "fontWeight": "bold",
          "fontSize": "sm",
          "marginBottom": 2
        }
      },
      {
        "id": "help-section",
        "type": "Container",
        "props": {
          "vertical": true
        },
        "styles": {
          "backgroundColor": "#374151",
          "padding": 1.5,
          "borderRadius": 8,
          "alignItems": "flex-start"
        },
        "children": [
          {
            "id": "help-icon",
            "type": "Container",
            "props": {},
            "styles": {
              "width": "12px",
              "height": "12px",
              "backgroundColor": "#6B7280",
              "borderRadius": "50%",
              "marginRight": 1,
              "marginTop": 0.5
            },
            "children": [
              {
                "id": "question-mark",
                "type": "Text",
                "props": {
                  "text": "?"
                },
                "styles": {
                  "textColor": "text",
                  "fontSize": "xs",
                  "textAlign": "center"
                }
              }
            ]
          },
          {
            "id": "help-text",
            "type": "Text",
            "props": {
              "text": "Where do I find my User ID?"
            },
            "styles": {
              "textColor": "text",
              "fontSize": "xs",
              "flex": 1
            }
          },
          {
            "id": "dropdown-arrow",
            "type": "Text",
            "props": {
              "text": "▼"
            },
            "styles": {
              "textColor": "#9CA3AF",
              "fontSize": "xs"
            }
          }
        ]
      }
    ]
  }
}





