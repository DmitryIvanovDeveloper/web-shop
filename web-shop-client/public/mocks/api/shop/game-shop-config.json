{
  "version": "1.0",
  "platform": "web",
  "theme": {
    "colors": {
      "primary": "#FF6B35",
      "secondary": "#2C1810",
      "accent": "#FFD700",
      "background": "#1A0E08",
      "surface": "#2C1810",
      "text": "#FFFFFF",
      "textSecondary": "#D4AF37",
      "success": "#00FF00",
      "error": "#FF4444",
      "warning": "#FFA500",
      "border": "#8B4513"
    },
    "spacing": {
      "unit": "rem",
      "scale": [0, 0.25, 0.5, 0.75, 1, 1.5, 2, 3, 4]
    }
  },
  "layout": {
    "type": "container",
    "id": "game-shop-page",
    "props": {
      "padding": 2,
      "maxWidth": "1440px",
      "backgroundColor": "background"
    },
    "children": [
      {
        "type": "Header",
        "id": "page-header",
        "props": {
          "title": "🎮 Игровой Магазин",
          "fontSize": 4,
          "marginBottom": 2,
          "color": "accent"
        }
      },
      {
        "type": "CategoryFilterWrapper",
        "id": "category-filter",
        "props": {
          "marginBottom": 2
        },
        "styles": {
          "button": {
            "padding": [0.75, 1.5],
            "borderRadius": 0.5,
            "backgroundColor": "secondary",
            "color": "accent",
            "borderWidth": 2,
            "borderColor": "border",
            "fontSize": 0.875,
            "fontWeight": 600,
            "hover": {
              "backgroundColor": "primary",
              "borderColor": "primary"
            },
            "active": {
              "backgroundColor": "accent",
              "borderColor": "accent",
              "color": "secondary"
            }
          }
        }
      },
      {
        "type": "GameProductGrid",
        "id": "game-product-grid",
        "props": {
          "columns": {
            "mobile": 1,
            "tablet": 2,
            "desktop": 4
          },
          "gap": 1.5
        },
        "children": [
          {
            "type": "ProductCard",
            "id": "game-product-card-template",
            "props": {
              "showDiscount": true,
              "showPoints": true,
              "imageHeight": 10
            },
            "visible": {
              "condition": "product.inStock === true"
            },
            "styles": {
              "container": {
                "backgroundColor": "surface",
                "borderRadius": 1,
                "borderColor": "border",
                "borderWidth": 2,
                "padding": 0,
                "overflow": "hidden",
                "boxShadow": "0 0 20px rgba(255, 215, 0, 0.3)",
                "cursor": "pointer",
                "transition": "all 0.3s ease-in-out",
                "hover": {
                  "borderColor": "accent",
                  "boxShadow": "0 0 30px rgba(255, 215, 0, 0.6)",
                  "transform": "translateY(-8px) scale(1.05)"
                }
              },
              "image": {
                "height": 10,
                "backgroundColor": "background",
                "display": "flex",
                "alignItems": "center",
                "justifyContent": "center",
                "iconSize": 4,
                "borderBottom": "2px solid border"
              },
              "content": {
                "padding": 1
              },
              "title": {
                "fontSize": 1.125,
                "fontWeight": 700,
                "color": "accent",
                "marginBottom": 0.5,
                "textAlign": "center"
              },
              "description": {
                "fontSize": 0.875,
                "color": "textSecondary",
                "marginBottom": 0.75,
                "lineClamp": 2,
                "textAlign": "center"
              },
              "category": {
                "backgroundColor": "primary",
                "color": "text",
                "padding": [0.25, 0.5],
                "borderRadius": 0.5,
                "fontSize": 0.75,
                "fontWeight": 600,
                "textTransform": "uppercase",
                "marginBottom": 0.75,
                "textAlign": "center"
              },
              "price": {
                "fontSize": 1.5,
                "fontWeight": 700,
                "color": "accent",
                "marginBottom": 1,
                "textAlign": "center"
              },
              "priceOriginal": {
                "fontSize": 1,
                "color": "textSecondary",
                "textDecoration": "line-through",
                "marginRight": 0.5
              },
              "points": {
                "display": "flex",
                "gap": 1,
                "marginBottom": 1,
                "fontSize": 0.875,
                "justifyContent": "center",
                "rp": {
                  "color": "success"
                },
                "lp": {
                  "color": "warning"
                }
              },
              "button": {
                "width": "100%",
                "backgroundColor": "primary",
                "color": "text",
                "padding": [0.75, 1.5],
                "borderRadius": 0.5,
                "fontSize": 1,
                "fontWeight": 700,
                "border": "2px solid accent",
                "cursor": "pointer",
                "transition": "all 0.2s ease-in-out",
                "textTransform": "uppercase",
                "hover": {
                  "backgroundColor": "accent",
                  "color": "secondary",
                  "transform": "scale(1.05)"
                },
                "disabled": {
                  "backgroundColor": "border",
                  "cursor": "not-allowed",
                  "transform": "scale(1)"
                }
              }
            }
          }
        ]
      },
      {
        "type": "ProductPopup",
        "id": "product-popup",
        "props": {
          "overlayOpacity": 0.7
        },
        "styles": {
          "overlay": {
            "backgroundColor": "rgba(26, 14, 8, 0.8)",
            "position": "fixed",
            "inset": 0,
            "display": "flex",
            "alignItems": "center",
            "justifyContent": "center",
            "zIndex": 50
          },
          "container": {
            "backgroundColor": "surface",
            "borderRadius": 1,
            "maxWidth": "600px",
            "padding": 2,
            "border": "3px solid accent",
            "boxShadow": "0 0 40px rgba(255, 215, 0, 0.5)"
          }
        }
      },
      {
        "type": "LoadingState",
        "id": "loading-state",
        "styles": {
          "spinner": {
            "color": "accent",
            "size": 4,
            "animation": "spin"
          },
          "text": {
            "color": "textSecondary",
            "fontSize": 1.125,
            "marginTop": 1
          }
        }
      },
      {
        "type": "ErrorState",
        "id": "error-state",
        "styles": {
          "container": {
            "padding": 2,
            "textAlign": "center"
          },
          "icon": {
            "color": "error",
            "fontSize": 4
          },
          "text": {
            "color": "text",
            "fontSize": 1.25,
            "marginTop": 1
          }
        }
      },
      {
        "type": "ToastNotification",
        "id": "toast-notification",
        "props": {
          "position": "bottom-right",
          "duration": 3000
        },
        "styles": {
          "container": {
            "backgroundColor": "surface",
            "color": "accent",
            "padding": [1, 1.5],
            "borderRadius": 0.5,
            "boxShadow": "0 0 20px rgba(255, 215, 0, 0.3)",
            "border": "2px solid accent"
          }
        }
      }
    ]
  }
}
