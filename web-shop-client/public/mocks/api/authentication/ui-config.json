{
  "version": "1.0",
  "loginButton": {
    "layout": {
      "id": "login-button",
      "type": "Button",
      "props": {
        "text": "Login",
        "fullWidth": true
      },
      "styles": {
        "backgroundColor": "#FBBF24",
        "textColor": "#000000",
        "padding": 3,
        "borderRadius": 8,
        "fontWeight": "bold",
        "fontSize": "lg",
        "height": "56px",
        "width": "100%",
        "border": "none",
        "cursor": "pointer",
        "transition": "all 0.2s ease",
        "textAlign": "center"
      },
      "actions": {
        "onClick": {
          "type": "custom",
          "handler": "onLoginClick"
        }
      }
    },
    "theme": {
      "colors": {
        "primary": "#FBBF24",
        "background": "#282A3A",
        "surface": "#3B3D4F",
        "text": "#000000",
        "textSecondary": "#A0A0A0",
        "accent": "#87CEEB",
        "border": "#5C5E70",
        "success": "#10B981",
        "error": "#EF4444",
        "warning": "#F59E0B"
      },
      "spacing": [0, 4, 8, 12, 16, 20, 24, 32, 40, 48, 64, 80],
      "borderRadius": {
        "small": 4,
        "medium": 8,
        "large": 16
      },
      "typography": {
        "fontFamily": "system-ui, -apple-system, sans-serif",
        "fontSizes": {
          "xs": "12px",
          "sm": "14px",
          "base": "16px",
          "lg": "18px",
          "xl": "20px",
          "2xl": "24px"
        },
        "fontWeights": {
          "normal": 400,
          "medium": 500,
          "semibold": 600,
          "bold": 700
        }
      }
    },
    "text": "Login",
    "icon": "🔐",
    "styles": {
      "backgroundColor": "#FBBF24",
      "textColor": "#000000",
      "padding": 4,
      "borderRadius": 25,
      "fontWeight": "bold",
      "fontSize": "xl",
      "height": "56px",
      "width": "100%",
      "border": "none",
      "cursor": "pointer",
      "transition": "all 0.2s ease",
      "textAlign": "center"
    },
    "hoverStyles": {
      "opacity": 0.8
    },
    "activeStyles": {
      "transform": "scale(0.98)"
    },
    "loadingStyles": {
      "backgroundColor": "#6B7280",
      "textColor": "#FFFFFF",
      "cursor": "not-allowed",
      "opacity": 0.5
    },
    "loadingText": "Loading...",
    "position": {
      "fixed": false,
      "top": "auto",
      "right": "auto"
    },
    "showWhenAuthenticated": false
  },
  "loginPopup": {
    "theme": {
      "colors": {
        "primary": "#FFD700",
        "background": "#282A3A",
        "surface": "#3B3D4F",
        "text": "#FFFFFF",
        "textSecondary": "#A0A0A0",
        "accent": "#87CEEB",
        "border": "#5C5E70",
        "success": "#10B981",
        "error": "#EF4444"
      },
      "spacing": [0, 4, 8, 12, 16, 20, 24, 32, 40, 48, 64, 80]
    },
    "layout": {
      "id": "login-popup",
      "type": "Popup",
      "props": {
        "isOpen": true,
        "showCloseButton": true
      },
      "styles": {
        "backgroundColor": "#282A3A",
        "padding": 4,
        "borderRadius": 12,
        "width": "480px",
        "maxWidth": "90vw",
        "maxHeight": "90vh",
        "margin": "auto",
        "boxShadow": "0 20px 40px rgba(0, 0, 0, 0.5)"
      },
      "children": [
        {
          "id": "logo-section",
          "type": "Container",
          "props": {
            "vertical": true
          },
          "styles": {
            "textAlign": "center",
            "marginBottom": 3
          },
          "children": [
            {
              "id": "logo-box",
              "type": "Container",
              "props": {
                "vertical": true
              },
              "styles": {
                "backgroundColor": "#282A3A",
                "padding": 2,
                "borderRadius": 8,
                "marginBottom": 2,
                "display": "inline-flex"
              },
              "children": [
                {
                  "id": "logo-title",
                  "type": "Text",
                  "props": {
                    "text": "PG"
                  },
                  "styles": {
                    "textColor": "#FFD700",
                    "fontWeight": "bold",
                    "fontSize": "4xl",
                    "marginBottom": 1,
                    "fontFamily": "monospace"
                  }
                },
                {
                  "id": "logo-subtitle",
                  "type": "Text",
                  "props": {
                    "text": "3D"
                  },
                  "styles": {
                    "textColor": "#FFD700",
                    "fontSize": "4xl",
                    "fontWeight": "bold",
                    "fontFamily": "monospace"
                  }
                }
              ]
            },
            {
              "id": "welcome-text",
              "type": "Text",
              "props": {
                "text": "Welcome to"
              },
              "styles": {
                "textColor": "#FFFFFF",
                "fontSize": "base",
                "marginBottom": 1,
                "fontWeight": "normal"
              }
            },
            {
              "id": "title-text",
              "type": "Text",
              "props": {
                "text": "Pixel Gun 3D: Online Shooter Hub"
              },
              "styles": {
                "textColor": "text",
                "fontSize": "base",
                "fontWeight": "bold"
              }
            }
          ]
        },
        {
          "id": "instruction-text",
          "type": "Text",
          "props": {
            "text": "Enter your App ID to continue"
          },
          "styles": {
            "textColor": "text",
            "textAlign": "center",
            "fontSize": "sm",
            "marginBottom": 2
          }
        },
        {
          "id": "app-id-input",
          "type": "Container",
          "props": {},
          "styles": {
            "marginBottom": 2,
            "display": "flex",
            "flexDirection": "column"
          },
          "children": [
            {
              "id": "input-field",
              "type": "Container",
              "props": {},
              "styles": {
                "backgroundColor": "#3B3D4F",
                "border": "1px solid #5C5E70",
                "borderRadius": 8,
                "padding": 3,
                "width": "100%",
                "textAlign": "left",
                "flex": 1,
                "height": "48px"
              },
              "children": [
                {
                  "id": "input-text",
                  "type": "Input",
                  "props": {
                    "placeholder": "App ID",
                    "type": "text"
                  },
                  "styles": {
                    "color": "#A0A0A0",
                    "fontSize": "16px",
                    "backgroundColor": "transparent",
                    "border": "none",
                    "outline": "none",
                    "width": "100%",
                    "textAlign": "left"
                  },
                  "actions": {
                    "onChange": {
                      "type": "custom",
                      "handler": "handleAppIdChange"
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "agreement-section",
          "type": "Container",
          "props": {
            "vertical": true
          },
          "styles": {
            "marginBottom": 3,
            "alignItems": "flex-start"
          },
          "children": [
            {
              "id": "checkbox",
              "type": "Container",
              "props": {},
              "styles": {
                "width": "16px",
                "height": "16px",
                "backgroundColor": "#374151",
                "border": "1px solid #6B7280",
                "borderRadius": 2,
                "marginRight": 1,
                "marginTop": 0.5
              }
            },
            {
              "id": "agreement-text",
              "type": "Container",
              "props": {
                "vertical": true
              },
              "styles": {
                "flex": 1
              },
              "children": [
                {
                  "id": "age-text",
                  "type": "Text",
                  "props": {
                    "text": "I am 13 years of age or older and agree to the"
                  },
                  "styles": {
                    "textColor": "text",
                    "fontSize": "xs"
                  }
                },
                {
                  "id": "policies-links",
                  "type": "Container",
                  "props": {
                    "vertical": true
                  },
                  "styles": {
                    "marginTop": 0.5
                  },
                  "children": [
                    {
                      "id": "privacy-link",
                      "type": "Text",
                      "props": {
                        "text": "Privacy Policy"
                      },
                      "styles": {
                        "textColor": "#60A5FA",
                        "fontSize": "xs",
                        "marginBottom": 0.5
                      }
                    },
                    {
                      "id": "terms-link",
                      "type": "Text",
                      "props": {
                        "text": "Terms of Service"
                      },
                      "styles": {
                        "textColor": "#60A5FA",
                        "fontSize": "xs",
                        "marginBottom": 0.5
                      }
                    },
                    {
                      "id": "refund-link",
                      "type": "Text",
                      "props": {
                        "text": "Refund Policy"
                      },
                      "styles": {
                        "textColor": "#60A5FA",
                        "fontSize": "xs"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "login-button",
          "type": "Button",
          "props": {
            "text": "Login",
            "fullWidth": true
          },
          "styles": {
            "backgroundColor": "#FBBF24",
            "textColor": "#000000",
            "padding": 3,
            "borderRadius": 8,
            "fontWeight": "bold",
            "fontSize": "lg",
            "marginBottom": 3,
            "height": "48px"
          },
          "actions": {
            "onClick": {
              "type": "custom",
              "handler": "handleAuthSubmit"
            }
          }
        },
        {
          "id": "help-section",
          "type": "Container",
          "props": {
            "vertical": true
          },
          "styles": {
            "backgroundColor": "#3B3D4F",
            "padding": 2,
            "borderRadius": 8,
            "alignItems": "center",
            "border": "1px solid #5C5E70"
          },
          "children": [
            {
              "id": "help-icon",
              "type": "Container",
              "props": {},
              "styles": {
                "width": "12px",
                "height": "12px",
                "backgroundColor": "#6B7280",
                "borderRadius": "50%",
                "marginRight": 1,
                "marginTop": 0.5
              },
              "children": [
                {
                  "id": "question-mark",
                  "type": "Text",
                  "props": {
                    "text": "?"
                  },
                  "styles": {
                    "textColor": "text",
                    "fontSize": "xs",
                    "textAlign": "center"
                  }
                }
              ]
            },
            {
              "id": "help-text",
              "type": "Text",
              "props": {
                "text": "Where do I find my App ID?"
              },
              "styles": {
                "textColor": "#FFFFFF",
                "fontSize": "sm",
                "flex": 1,
                "marginLeft": 1
              }
            },
            {
              "id": "dropdown-arrow",
              "type": "Text",
              "props": {
                "text": "▼"
              },
              "styles": {
                "textColor": "#9CA3AF",
                "fontSize": "xs"
              }
            }
          ]
        }
      ]
    }
  }
}
