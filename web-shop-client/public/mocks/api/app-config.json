{
  "$schema": "../../app-config.schema.json",
  "version": "1.0",
  "environment": "production",
  "theme": {
    "colors": {
      "primary": "#3B5AFE",
      "secondary": "#FBBF24",
      "accent": "#FF6B35",
      "background": "#0D1117",
      "surface": "#161B22",
      "text": "#FFFFFF",
      "textSecondary": "#A0A0A0",
      "success": "#10B981",
      "error": "#EF4444",
      "warning": "#FFA500",
      "border": "#374151"
    },
    "spacing": [0, 4, 8, 12, 16, 20, 24, 32, 40, 48, 64, 80],
    "borderRadius": {
      "small": 4,
      "medium": 8,
      "large": 12,
      "full": 9999
    },
    "typography": {
      "fontFamily": "system-ui, -apple-system, sans-serif",
      "fontSize": {
        "xs": "12px",
        "sm": "14px",
        "base": "16px",
        "lg": "18px",
        "xl": "20px",
        "2xl": "24px",
        "3xl": "30px",
        "4xl": "36px"
      },
      "fontWeight": {
        "normal": 400,
        "medium": 500,
        "semibold": 600,
        "bold": 700,
        "extrabold": 800
      }
    }
  },
  "background": {
    "backgroundImage": "url('/background.jpg')",
    "backgroundSize": "cover",
    "backgroundPosition": "center",
    "backgroundRepeat": "no-repeat"
  },
  "shared": {
    "offerCardUI": {
      "type": "OfferCard",
      "id": "offer-card-template",
      "props": {},
      "styles": {
        "container": {
          "backgroundColor": "#1F2937",
          "borderRadius": "8px",
          "shadow": "lg"
        },
        "image": {
          "backgroundColor": "#374151",
          "aspectRatio": "1.5 / 1"
        },
        "includedItems": {
          "backgroundColor": "#374151",
          "itemBackgroundColor": "#4B5563"
        },
        "title": {
          "fontSize": "clamp(10px, 4cqw, 18px)",
          "fontWeight": "bold",
          "color": "#FFFFFF"
        },
        "rarity": {
          "backgroundColor": "#8A2BE2",
          "color": "#FFFFFF"
        },
        "buyButton": {
          "backgroundColor": "#FF6B35",
          "color": "#FFFFFF",
          "borderRadius": "8px",
          "fontSize": "clamp(12px, 4cqw, 18px)",
          "fontWeight": "bold",
          "padding": "12px 8px",
          "minHeight": "48px"
        },
        "purchasedBadge": {
          "backgroundColor": "#10B981",
          "color": "#FFFFFF"
        },
        "bonuses": {
          "rpColor": "#FBBF24",
          "lpColor": "#3B82F6",
          "fontSize": "12px"
        }
      },
      "children": []
    },
    "productCardUI": {
      "type": "OfferCard",
      "id": "product-card-template",
      "props": {},
      "styles": {
        "container": {
          "backgroundColor": "#1F2937",
          "borderRadius": "8px",
          "shadow": "lg"
        },
        "image": {
          "backgroundColor": "#374151",
          "aspectRatio": "1 / 1"
        },
        "title": {
          "fontSize": "clamp(10px, 4cqw, 18px)",
          "fontWeight": "bold",
          "color": "#FFFFFF"
        },
        "buyButton": {
          "backgroundColor": "#FF6B35",
          "color": "#FFFFFF",
          "borderRadius": "8px",
          "fontSize": "clamp(12px, 4cqw, 18px)",
          "fontWeight": "bold",
          "padding": "12px 8px",
          "minHeight": "48px"
        },
        "purchasedBadge": {
          "backgroundColor": "#10B981",
          "color": "#FFFFFF"
        }
      },
      "children": []
    }
  },
  "moduleSchemas": {
    "authentication": {
      "labels": {
        "fields": [
          { "key": "loginButton", "type": "string", "required": true, "default": "Login", "description": "Text for login button" },
          { "key": "logoutButton", "type": "string", "required": true, "default": "Logout", "description": "Text for logout button" },
          { "key": "appIdPlaceholder", "type": "string", "required": true, "default": "Enter App ID", "description": "Placeholder for App ID input" },
          { "key": "userIdPlaceholder", "type": "string", "required": true, "default": "Enter User ID", "description": "Placeholder for User ID input" },
          { "key": "submitButton", "type": "string", "required": true, "default": "Submit" },
          { "key": "welcomeTitle", "type": "string", "required": true, "default": "PG3D HUB" },
          { "key": "welcomeMessage", "type": "string", "required": true, "default": "Welcome to" },
          { "key": "welcomeSubtitle", "type": "string", "required": true, "default": "WebShop Game Hub" },
          { "key": "enterAppId", "type": "string", "required": true, "default": "Enter your App ID" },
          { "key": "enterUserId", "type": "string", "required": true, "default": "Enter your User ID" },
          { "key": "successMessage", "type": "string", "required": true, "default": "Success!" },
          { "key": "loadingMessage", "type": "string", "required": true, "default": "Loading..." },
          { "key": "errorMessage", "type": "string", "required": true, "default": "Error" },
          { "key": "helpQuestion", "type": "string", "required": false, "default": "Need help?" },
          { "key": "helpAnswer", "type": "string", "required": false, "default": "Contact support" },
          { "key": "agreementText", "type": "string", "required": false, "default": "I agree" },
          { "key": "privacyPolicy", "type": "string", "required": false, "default": "Privacy Policy" },
          { "key": "termsOfService", "type": "string", "required": false, "default": "Terms of Service" },
          { "key": "refundPolicy", "type": "string", "required": false, "default": "Refund Policy" }
        ]
      },
      "settings": {
        "fields": [
          { "key": "closeDelay", "type": "number", "required": true, "default": 1500, "min": 0, "max": 10000, "description": "Delay before closing popup (ms)" },
          { "key": "showHelpSection", "type": "boolean", "required": true, "default": true, "description": "Show help section in auth popup" },
          { "key": "showAgreement", "type": "boolean", "required": true, "default": true, "description": "Show agreement checkbox" },
          { "key": "rememberUser", "type": "boolean", "required": true, "default": true, "description": "Remember user in localStorage" }
        ]
      },
      "ui": {
        "fields": [
          { "key": "loginButtonUI", "type": "componentNode", "required": true, "description": "Login button UI configuration" }
        ]
      }
    },
    "products": {
      "labels": {
        "fields": [
          { "key": "title", "type": "string", "required": true, "default": "Products" },
          { "key": "buyButton", "type": "string", "required": true, "default": "Buy Now" },
          { "key": "purchasedBadge", "type": "string", "required": true, "default": "PURCHASED" },
          { "key": "emptyState", "type": "string", "required": true, "default": "No products available" },
          { "key": "loadingState", "type": "string", "required": true, "default": "Loading products..." }
        ]
      },
      "settings": {
        "fields": [
          { "key": "gridColumns", "type": "number", "required": true, "default": 4, "min": 1, "max": 12, "description": "Number of columns in product grid" },
          { "key": "gridGap", "type": "number", "required": true, "default": 16, "min": 0, "max": 64, "description": "Gap between grid items (px)" },
          { "key": "enableFilters", "type": "boolean", "required": true, "default": false, "description": "Enable product filters" }
        ]
      }
    },
    "offers": {
      "labels": {
        "fields": [
          { "key": "title", "type": "string", "required": true, "default": "Special Offers" },
          { "key": "featuredTitle", "type": "string", "required": true, "default": "Featured Deals" },
          { "key": "emptyState", "type": "string", "required": true, "default": "No offers available" },
          { "key": "expiredBadge", "type": "string", "required": true, "default": "EXPIRED" }
        ]
      },
      "settings": {
        "fields": [
          { "key": "featuredThreshold", "type": "number", "required": true, "default": 2, "min": 0, "description": "Number of purchases to show featured offers" },
          { "key": "gridColumns", "type": "number", "required": true, "default": 3, "min": 1, "max": 12, "description": "Number of columns in offers grid" },
          { "key": "gridGap", "type": "number", "required": true, "default": 16, "min": 0, "max": 64, "description": "Gap between grid items (px)" }
        ]
      }
    },
    "uiRenderer": {
      "ui": {
        "fields": [
          { "key": "sidebar", "type": "componentNode", "required": true, "description": "Left sidebar layout configuration" },
          { "key": "rightSidebar", "type": "componentNode", "required": true, "description": "Right sidebar layout configuration" },
          { "key": "store", "type": "componentNode", "required": true, "description": "Main store content layout configuration" }
        ]
      }
    }
  },
  "modules": {
    "authentication": {
      "labels": {
        "loginButton": "Login",
        "logoutButton": "Logout",
        "appIdPlaceholder": "Enter App ID",
        "userIdPlaceholder": "Enter User ID",
        "submitButton": "Submit",
        "welcomeTitle": "PG3D HUB",
        "welcomeMessage": "Welcome to",
        "welcomeSubtitle": "WebShop Game: Online Hub",
        "enterAppId": "Enter your App ID to continue",
        "enterUserId": "Enter your User ID",
        "successMessage": "Login Successful!",
        "loadingMessage": "Validating credentials...",
        "errorMessage": "Authentication Failed",
        "helpQuestion": "Where do I find my App ID?",
        "helpAnswer": "App ID is provided by WebShop Game app. Try: game-123 or app-456",
        "agreementText": "I am 13 years of age or older and agree to the",
        "privacyPolicy": "Privacy Policy",
        "termsOfService": "Terms of Service",
        "refundPolicy": "Refund Policy"
      },
      "settings": {
        "closeDelay": 1500,
        "showHelpSection": true,
        "showAgreement": true,
        "rememberUser": true
      },
      "loginButtonUI": {
        "type": "Button",
        "id": "login-button",
        "props": {
          "text": "Login",
          "icon": "",
          "fullWidth": true
        },
        "styles": {
          "backgroundColor": "#FBBF24",
          "color": "#000000",
          "fontWeight": "bold",
          "fontSize": "16px",
          "height": "48px",
          "borderRadius": "8px",
          "padding": "12px 16px",
          "width": "100%",
          "border": "none",
          "cursor": "pointer",
          "transition": "all 0.2s ease"
        },
        "actions": {
          "onClick": {
            "type": "custom",
            "handler": "handleLoginClick"
          }
        },
        "children": []
      }
    },
    "products": {
      "labels": {
        "title": "Products",
        "buyButton": "Buy Now",
        "purchasedBadge": "PURCHASED",
        "emptyState": "No products available",
        "loadingState": "Loading products..."
      },
      "settings": {
        "gridColumns": 4,
        "gridGap": 16,
        "enableFilters": false
      }
    },
    "offers": {
      "labels": {
        "title": "Special Offers",
        "featuredTitle": "Featured Deals",
        "emptyState": "No offers available",
        "expiredBadge": "EXPIRED"
      },
      "settings": {
        "featuredThreshold": 2,
        "gridColumns": 3,
        "gridGap": 16
      }
    },
    "uiRenderer": {
      "sidebar": {
        "version": "1.0",
        "theme": {
          "colors": {
            "primary": "#3B5AFE",
            "background": "#0D1117",
            "surface": "#161B22",
            "text": "#FFFFFF"
          },
          "spacing": [0, 0.5, 1, 1.5, 2, 3, 4]
        },
        "layout": {
          "id": "sidebar-container",
          "type": "Container",
          "props": {
            "vertical": true,
            "sidebar": true
          },
          "styles": {
            "padding": 8,
            "backgroundColor": "surface",
            "minHeight": "100vh",
            "width": "100%"
          },
          "children": [
            {
              "id": "store-button",
              "type": "Button",
              "props": {
                "text": "Store",
                "icon": "🛒",
                "fullWidth": true
              },
              "styles": {
                "padding": 4,
                "backgroundColor": "primary",
                "textColor": "text",
                "justifyContent": "flex-start"
              }
            },
            {
              "id": "patch-notes-button",
              "type": "Button",
              "props": {
                "text": "Patch Notes",
                "icon": "📋",
                "fullWidth": true
              },
              "styles": {
                "padding": 4,
                "backgroundColor": "surface",
                "textColor": "text",
                "justifyContent": "flex-start",
                "hoverBackgroundColor": "primary"
              },
              "actions": {
                "onClick": {
                  "type": "custom",
                  "handler": "navigateToPatchNotes"
                }
              }
            }
          ]
        }
      },
      "rightSidebar": {
        "version": "1.0",
        "theme": {
          "colors": {
            "primary": "#3B5AFE",
            "background": "#0D1117",
            "surface": "#161B22",
            "text": "#FFFFFF",
            "textSecondary": "#A0A0A0"
          },
          "spacing": [0, 4, 8, 12, 16, 20, 24, 32, 40, 48, 64, 80]
        },
        "layout": {
          "type": "Container",
          "id": "right-sidebar",
          "props": {
            "vertical": true
          },
          "styles": {
            "width": "100%",
            "height": "100%"
          },
          "children": []
        }
      },
      "store": {
        "version": "1.0",
        "theme": {
          "colors": {
            "primary": "#3B5AFE",
            "background": "#0D1117",
            "surface": "#161B22",
            "text": "#FFFFFF",
            "textSecondary": "#A0A0A0"
          },
          "spacing": [0, 4, 8, 12, 14, 16, 20, 24, 32, 40, 48, 64, 80]
        },
        "layout": {
          "type": "Container",
          "id": "store",
          "props": {
            "vertical": true
          },
          "styles": {
            "padding": 4,
            "width": "100%",
            "minHeight": "100vh"
          },
          "children": [
            {
              "type": "Text",
              "id": "page-title",
              "props": {
                "text": ""
              },
              "styles": {
                "textColor": "text",
                "fontSize": "4xl",
                "fontWeight": "bold",
                "marginBottom": 8,
                "textAlign": "center"
              }
            },
            {
              "type": "OffersList",
              "id": "evaluated-offers",
              "props": {},
              "styles": {
                "className": "mb-6"
              }
            },
            {
              "type": "ProductsList",
              "id": "products-list",
              "props": {},
              "styles": {
                "className": ""
              }
            }
          ]
        }
      }
    }
  },
  "constants": {
    "api": {
      "timeout": 10000,
      "retryAttempts": 3
    },
    "ui": {
      "animationDuration": 300,
      "toastDuration": 3000,
      "mobileBreakpoint": 1024
    }
  }
}



