{
  "name": "web-shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/kill-port.js 3001 && next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:unit": "vitest run src/**/*.test.ts --exclude src/__tests__/integration/** --exclude src/__tests__/e2e/**",
    "test:integration": "vitest run src/__tests__/integration/**",
    "test:e2e": "vitest run src/__tests__/e2e/**",
    "test:data-flow": "vitest run src/**/*data-flow*.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^5.2.0",
    "@stripe/stripe-js": "^8.1.0",
    "@supabase/supabase-js": "^2.76.1",
    "@types/uuid": "^10.0.0",
    "inversify": "^7.10.2",
    "lucide-react": "^0.546.0",
    "next": "15.1.11",
    "react": "^18",
    "react-avatar": "^5.0.4",
    "react-dom": "^18",
    "react-spinners": "^0.17.0",
    "recharts": "^3.2.1",
    "reflect-metadata": "^0.2.2",
    "stripe": "^19.1.0",
    "uuid": "^13.0.0",
    "uuidv4": "^6.2.13",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^8",
    "eslint-config-next": "15.1.2",
    "jsdom": "^27.4.0",
    "playwright": "^1.56.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
