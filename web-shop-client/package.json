{
  "name": "web-shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:unit": "vitest run src/**/*.test.ts --exclude src/__tests__/integration/** --exclude src/__tests__/e2e/**",
    "test:integration": "vitest run src/__tests__/integration/**",
    "test:e2e": "vitest run src/__tests__/e2e/**",
    "test:data-flow": "vitest run src/**/*data-flow*.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "inversify": "^7.10.2",
    "next": "15.1.2",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^3.2.1",
    "reflect-metadata": "^0.2.2",
    "uuidv4": "^6.2.13"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^8",
    "eslint-config-next": "15.1.2",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
